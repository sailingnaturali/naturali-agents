# naturali-agents environment
#
# Variables read by the Poseidon daemon (poseidon/daemon.py), the daily briefing
# (scripts/briefing.py), and agent skills. In the live setup these live in
# ~/.poseidon/.env (Poseidon and briefing.py load it). Copy this file to .env
# for local runs, or copy the relevant lines into ~/.poseidon/.env.
#
# .env is gitignored — never commit real secrets. Values below are placeholders.

# --- SignalK (marine data) ---
# Pi 5 running SignalK. The signalk-mcp server reads this too.
SIGNALK_URL=http://naturalaspi.local:3000

# --- MQTT (Poseidon daemon subscribes to naturali/intents/# and naturali/alerts/#) ---
# Default target is HA Green's Mosquitto broker (192.168.68.90). Poseidon owns
# all MQTT lanes since 2026-06-11 (replaced the retired mqtt-bridge).
MQTT_BROKER=naturalaspi.local
MQTT_PORT=1883
MQTT_USER=naturali
MQTT_PASSWORD=

# --- Agent routing ---
# AGENT_NAME is the HA-facing logical agent name.
AGENT_NAME=navigator

# --- Home Assistant (briefing posts TTS via HA) ---
HA_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=

# --- Briefing archive (briefing.py's sqlite: marked_moments + tank_readings) ---
BRIEFING_DB_PATH=~/.naturali/briefings.db

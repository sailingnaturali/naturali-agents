# naturali-agents environment
#
# Variables read by the Navigator bridges (bridges/), the daily briefing
# (scripts/briefing.py), and the Hermes skill. In the live setup these live in
# ~/.hermes/.env (the bridges and briefing.py load it). Copy this file to .env
# for local runs, or copy the relevant lines into ~/.hermes/.env.
#
# .env is gitignored — never commit real secrets. Values below are placeholders.

# --- SignalK (marine data) ---
# Pi 5 running SignalK. The signalk-mcp server reads this too (set in ~/.hermes/config.yaml).
SIGNALK_URL=http://naturalaspi.local:3000

# --- MQTT (HA voice <-> Hermes bridge) ---
# Default target is the Pi (naturalaspi.local). Phase 0 currently runs Mosquitto
# on HA Green — point MQTT_BROKER at that host until the Phase 1 broker migration.
MQTT_BROKER=naturalaspi.local
MQTT_PORT=1883
MQTT_USER=naturali
MQTT_PASSWORD=

# --- Agent / skill routing ---
# AGENT_NAME (HA-facing logical agent) and HERMES_SKILL (Hermes skill id) are
# intentionally independent — see SPEC.md.
AGENT_NAME=navigator
HERMES_SKILL=naturali/navigator

# --- Home Assistant (briefing posts TTS via HA) ---
HA_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=

# --- Logbook (sea-day capture sqlite; see logbook-mcp) ---
LOGBOOK_DB_PATH=~/.naturali/logbook.sqlite

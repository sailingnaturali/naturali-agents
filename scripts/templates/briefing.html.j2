<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- The dashboard iframe must never serve a stale day's briefing from cache. -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>Daily Briefing — s/v {{ vessel_name }}</title>
  <style>
    :root {
      --bg: #0b1220;
      --card: #111a2b;
      --text: #e5e7eb;
      --muted: #94a3b8;
      --teal: #5eead4;
      --amber: #fbbf24;
      --info: #60a5fa;
      --caution: #fbbf24;
      --warning: #f87171;
      --border: #1e293b;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
        Helvetica, Arial, sans-serif;
      font-size: 18px;
      line-height: 1.45;
    }
    .wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 1.25rem;
    }
    header.band {
      background: linear-gradient(90deg, #0f1a2e, #14233c);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.1rem 1.3rem;
      margin-bottom: 1.25rem;
    }
    header.band .title {
      color: var(--teal);
      font-size: 0.95rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 0 0 0.35rem 0;
    }
    header.band .meta {
      font-size: 1.5rem;
      font-weight: 600;
    }
    header.band .meta .sep { color: var(--muted); padding: 0 0.45rem; }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.25rem;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.15rem 1.3rem;
    }
    .card.full { grid-column: 1 / -1; }
    .card h2 {
      margin: 0 0 0.8rem 0;
      font-size: 1.05rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--amber);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 0.6rem;
    }
    th, td {
      text-align: left;
      padding: 0.5rem 0.6rem;
      border-bottom: 1px solid var(--border);
    }
    th {
      color: var(--muted);
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    td { font-size: 1.05rem; }
    p { margin: 0.6rem 0 0 0; }
    .departure {
      margin-top: 0.6rem;
      font-size: 1.1rem;
      color: var(--teal);
    }
    .departure .label {
      color: var(--muted);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-right: 0.4rem;
    }
    ul { margin: 0; padding-left: 1.2rem; }
    li { margin-bottom: 0.4rem; }
    .panel {
      margin-top: 1rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 0.85rem 1rem 1rem;
    }
    .panel-h {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.7rem;
    }
    .wind { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .wind-data { flex: 1 1 150px; display: flex; flex-direction: column; gap: 0.55rem; }
    .wd-row {
      display: flex; justify-content: space-between; align-items: baseline;
      border-bottom: 1px solid #1e293b; padding-bottom: 0.45rem;
    }
    .wd-row span { color: var(--muted); }
    .wd-row b { color: var(--text); font-weight: 600; }
    .wind-dial { flex: 0 0 150px; }
    .panel svg { max-width: 100%; height: auto; display: block; }
    .tides-link { margin-top: 0.8rem; }
    .tides-link a { color: var(--teal); text-decoration: none; }
    .tides-link a:hover { text-decoration: underline; }
    .tank-panel { margin: 0.4rem 0 1.1rem; }
    .tank-panel:last-child { margin-bottom: 0.3rem; }
    .tank-panel svg { max-width: 100%; height: auto; display: block; }
    .advisories { margin-top: 1.25rem; display: grid; gap: 0.7rem; }
    .advisory {
      border-radius: 10px;
      padding: 0.8rem 1rem;
      font-size: 1.05rem;
      border-left: 5px solid var(--muted);
      background: #0e1626;
    }
    .advisory.info { border-left-color: var(--info); }
    .advisory.caution { border-left-color: var(--caution); }
    .advisory.warning { border-left-color: var(--warning); }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="band">
      <p class="title">Daily Briefing</p>
      <div class="meta">
        {% for p in [b.header.date, b.header.position, b.header.destination] | select | list -%}
          {% if not loop.first %}<span class="sep">·</span>{% endif %}{{ p }}
        {%- endfor %}
      </div>
    </header>

    <div class="cards">
      <section class="card">
        <h2>Weather</h2>
        <table>
          <thead>
            <tr><th>Source</th><th>Wind</th><th>Pressure</th></tr>
          </thead>
          <tbody>
            {% for r in b.weather.rows or [] %}
            <tr>
              <td>{{ r.source or "" }}</td>
              <td>{{ r.wind or "" }}</td>
              <td>{{ r.pressure or "" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <p>{{ b.weather.analysis or "" }}</p>
      </section>

      <section class="card">
        <h2>Navigation</h2>
        <table>
          <thead>
            <tr><th>Type</th><th>Time</th><th>Height</th></tr>
          </thead>
          <tbody>
            {% for t in b.navigation.tide_rows or [] %}
            <tr>
              <td>{{ t.type or "" }}</td>
              <td>{{ t.time or "" }}</td>
              <td>{{ t.height or "" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="departure"><span class="label">Departure</span>{{ b.navigation.departure or "" }}</div>
        <p>{{ b.navigation.analysis or "" }}</p>
        {% if compass_svg and wind %}
        <div class="panel">
          <div class="panel-h">Wind</div>
          <div class="wind">
            <div class="wind-data">
              <div class="wd-row"><span>Wind</span><b>{{ wind.speed_kn|round|int }} kn</b></div>
              <div class="wd-row"><span>Direction</span><b>{{ wind.direction_deg|round|int }}° {{ wind.cardinal }}</b></div>
            </div>
            <div class="wind-dial">{{ compass_svg|safe }}</div>
          </div>
        </div>
        {% endif %}
        {% if tides_url %}
        <p class="tides-link"><a href="{{ tides_url }}" target="_blank" rel="noopener">Full tide chart →</a></p>
        {% endif %}
      </section>

      <section class="card">
        <h2>Vessel Systems</h2>
        {% if house_panel %}<div class="tank-panel">{{ house_panel|safe }}</div>{% endif %}
        {% for panel in tank_panels %}
        <div class="tank-panel">{{ panel|safe }}</div>
        {% endfor %}
        {% if b.vessel_systems.notes %}
        <ul>
          {% for note in b.vessel_systems.notes or [] %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </section>
    </div>

    {% if b.advisories %}
    <div class="advisories">
      {% for a in b.advisories or [] %}
      <div class="advisory {{ a.level }}">{{ a.text }}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <!-- The nav-station iframe loads once and never refetches on its own; the no-cache
       meta tags above only matter when a request is actually made. Reload ourselves
       periodically with a fresh cache-buster so a wall display picks up each new day. -->
  <script>
    setTimeout(function () {
      window.location.replace(window.location.pathname + "?v=" + Date.now());
    }, 30 * 60 * 1000);
  </script>
</body>
</html>

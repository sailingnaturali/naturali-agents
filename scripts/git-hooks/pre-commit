#!/usr/bin/env bash
# Keep the committed prompt mirrors in sync with the skill source bodies.
#
# When a commit touches the Navigator or Engineer skill source, copy the body.md
# to prompts/*.md and re-stage so the committed doc matches the source.
# (The old hermes runtime deploys — deploy-{navigator,engineer,soul}.sh — are
# removed; Poseidon reads skills/ directly at runtime.)
#
# Install: scripts/git-hooks/install.sh  (symlinks this into .git/hooks/)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
changed="$(git diff --cached --name-only --diff-filter=ACMR)"

if printf '%s\n' "$changed" | grep -Eq '^skills/navigator/'; then
  echo "pre-commit: navigator source changed — regenerating prompts/navigator.md"
  cp "$repo_root/skills/navigator/body.md" "$repo_root/prompts/navigator.md"
  git add "$repo_root/prompts/navigator.md"
fi

if printf '%s\n' "$changed" | grep -Eq '^skills/engineer/'; then
  echo "pre-commit: engineer source changed — regenerating prompts/engineer.md"
  cp "$repo_root/skills/engineer/body.md" "$repo_root/prompts/engineer.md"
  git add "$repo_root/prompts/engineer.md"
fi

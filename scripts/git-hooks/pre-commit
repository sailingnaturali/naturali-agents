#!/usr/bin/env bash
# Keep the Navigator skill and the base persona deployed and in sync on commit.
#
# When a commit touches the Navigator source (or its deploy script / the shared
# vessel-name resolver), rebuild the runtime SKILL.md and regenerate
# prompts/navigator.md, then re-stage the regenerated prompt so the committed
# doc matches what was deployed. When it touches SOUL.md (the base persona Hermes
# loads on every request) or its deploy script, redeploy ~/.hermes/SOUL.md.
#
# Install: scripts/git-hooks/install.sh  (symlinks this into .git/hooks/)
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
changed="$(git diff --cached --name-only --diff-filter=ACMR)"

if printf '%s\n' "$changed" | grep -Eq '^(skills/navigator/|scripts/(deploy-navigator|vessel-name)\.sh$)'; then
  echo "pre-commit: navigator source changed — deploying skill"
  bash "$repo_root/scripts/deploy-navigator.sh"
  # Re-stage the regenerated repo mirror so it lands in this commit.
  git add "$repo_root/prompts/navigator.md"
fi

if printf '%s\n' "$changed" | grep -Eq '^(SOUL\.md$|scripts/(deploy-soul|vessel-name)\.sh$)'; then
  echo "pre-commit: persona source changed — deploying SOUL"
  bash "$repo_root/scripts/deploy-soul.sh"
fi

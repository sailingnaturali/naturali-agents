{
  "signalk": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/signalk-mcp",
      "signalk-mcp"
    ],
    "env": {}
  },
  "logbook": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/logbook-mcp",
      "logbook-mcp"
    ],
    "env": {
      "LOGBOOK_TZ": "America/Vancouver"
    }
  },
  "currents": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/currents-mcp",
      "currents-mcp"
    ],
    "env": {}
  },
  "weather": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/weather-mcp",
      "weather-mcp"
    ],
    "env": {}
  },
  "pilotbook": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/pilotbook-mcp",
      "pilotbook-mcp"
    ],
    "env": {
      "PILOTBOOK_VAULT_PATH": "~/src/sailingnaturali/pilotbook-vault"
    }
  },
  "colregs": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/colregs-mcp",
      "colregs-mcp"
    ],
    "env": {}
  },
  "vessel-knowledge": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/vessel-knowledge-mcp",
      "vessel-knowledge-mcp"
    ],
    "env": {
      "VESSEL_KNOWLEDGE_VAULT_PATH": "~/src/sailingnaturali/vessel-knowledge-vault",
      "VESSEL_KNOWLEDGE_BINDINGS_PATH": "~/src/sailingnaturali/infrastructure/mac-dev/signalk-config/bindings.json"
    }
  },
  "club-moorage": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--project",
      "~/src/sailingnaturali/club-moorage-mcp",
      "club-moorage-mcp"
    ],
    "env": {}
  },
  "mutes": {
    "type": "stdio",
    "command": "~/.local/bin/uv",
    "args": [
      "run",
      "--directory",
      "~/src/sailingnaturali/naturali-agents",
      "python",
      "-m",
      "poseidon.mutes_mcp"
    ],
    "env": {}
  }
}
